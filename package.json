{
  "name": "entra-doc-diff",
  "version": "1.0.0",
  "description": "Daily monitoring tool for Microsoft Entra documentation changes",
  "main": "src/monitor-docs.js",
  "scripts": {
    "start": "node src/monitor-docs.js",
    "test": "node src/test-discord-publisher.js && node src/test-monitor.js",
    "dev": "node --watch src/monitor-docs.js",
    "verify": "node verify.js",
    "generate-historical": "node scripts/generate-historical-data.js"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.6",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "diff": "^5.1.0",
    "marked": "^11.1.1",
    "moment-timezone": "^0.5.44",
    "node-html-parser": "^6.1.12",
    "openai": "^7.3.0",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "dotenv": "^16.3.1"
  },
  "keywords": [
    "github",
    "automation",
    "documentation",
    "monitoring",
    "entra"
  ],
  "author": "Merill Fernando",
  "license": "MIT"
}
