{
  "name": "entra-doc-diff",
  "version": "1.0.0",
  "description": "Daily monitoring tool for Microsoft Entra documentation changes",
  "main": "src/monitor-docs.js",
  "scripts": {
    "start": "node src/monitor-docs.js",
    "test": "node src/test-discord-publisher.js && node --test src/test-config.js src/test-monitor.js src/test-period-summaries.js src/test-update-state.js src/test-learn-diff.js src/test-static-site.js src/test-topic-icons.js src/test-search-index.js src/test-kit-publisher.js",
    "dev": "node scripts/serve-site.js",
    "monitor:dev": "node --watch src/monitor-docs.js",
    "build:site": "node scripts/build-static-site.js && node scripts/build-search-index.js",
    "summaries:periods": "node scripts/generate-period-summaries.js --current",
    "summaries:periods:backfill": "node scripts/generate-period-summaries.js --all",
    "summaries:days:backfill": "node scripts/generate-period-summaries.js --all --days",
    "preview:site": "node scripts/serve-site.js",
    "generate-historical": "node scripts/generate-historical-data.js"
  },
  "dependencies": {
    "diff": "^5.1.0",
    "marked": "^11.1.1",
    "moment-timezone": "^0.5.44",
    "node-html-parser": "^6.1.12",
    "node-htmldiff": "^0.9.4",
    "openai": "^7.3.0",
    "pagefind": "^1.5.2",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "dotenv": "^16.3.1"
  },
  "keywords": [
    "github",
    "automation",
    "documentation",
    "monitoring",
    "entra"
  ],
  "author": "Merill Fernando",
  "license": "MIT"
}
