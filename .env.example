# Environment variables for local testing
# Copy this file to .env and fill in your values

# Required: GitHub token for API access
GITHUB_TOKEN=your_github_token_here

# Optional: SendGrid configuration for email delivery
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=verified_sender@yourdomain.com
RECIPIENT_EMAIL=your_email@domain.com

# Optional: Custom repository to monitor (defaults to MicrosoftDocs/entra-docs)
# TARGET_REPO_OWNER=MicrosoftDocs
# TARGET_REPO_NAME=entra-docs
