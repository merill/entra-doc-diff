# Environment variables for local testing
# Copy this file to .env and fill in your values

# Microsoft Graph/Entra ID app configuration for workflow-failure alerts only
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SENDER_EMAIL=merill@elapora.com
FAILURE_RECIPIENT_EMAIL=merill@merill.net

# Local repository and optional target override
LOCAL_REPO_PATH=/path/to/entra-docs
TARGET_REPO_OWNER=MicrosoftDocs
TARGET_REPO_NAME=entra-docs

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_SUMMARY_REASONING_EFFORT=xhigh
OPENAI_SUMMARY_CONCURRENCY=3
OPENAI_SUMMARY_ENABLED=true

# Shared Entra Scout Discord incoming webhook
DISCORD_ENTRA_SCOUT_WEBHOOK_URL=
DISCORD_ENTRA_SCOUT_NAME=Entra Scout
DISCORD_ENTRA_SCOUT_AVATAR_URL=https://raw.githubusercontent.com/merill/entra-doc-diff/main/design/entra-scout-avatar-1024.png
DISCORD_ENABLED=true
DISCORD_DRY_RUN=true

# Prevent legacy local email helpers from sending
DRY_RUN=true
