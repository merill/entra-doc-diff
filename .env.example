# Environment variables for local testing
# Copy this file to .env and fill in your values

# Required: Microsoft Graph/Entra ID app configuration for email delivery
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SENDER_EMAIL=merill@elapora.com
RECIPIENT_EMAIL=merill@merill.net

# Optional: Local repository path for development (when not using GitHub Actions)
LOCAL_REPO_PATH=/Users/merill/GitHub/entra-docs-pr

# Optional: Custom repository to monitor (defaults to MicrosoftDocs/entra-docs-pr)
TARGET_REPO_OWNER=MicrosoftDocs
TARGET_REPO_NAME=entra-docs-pr
