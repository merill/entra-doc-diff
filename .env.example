# Local development only. CI passes these as repository secrets and variables;
# nothing here is required to build the site from the committed data.
#
# The generator lives in @merill/dailynews-engine. Everything that is *about*
# this product — its taxonomy, its prose, its Learn URL routes — is in
# dailynews.config.js, not here. These are per-run operational knobs.

# --- where the sources are, when they are not in the default place ---
DOCS_REPO_PATH=
MC_DATA_PATH=

# --- summaries ---
OPENAI_API_KEY=
OPENAI_SUMMARY_ENABLED=
OPENAI_SUMMARY_MODEL=
OPENAI_SUMMARY_REASONING_EFFORT=
OPENAI_SUMMARY_CONCURRENCY=

# --- Discord. The webhook name is product-neutral; the bot's name and avatar
# come from dailynews.config.js. ---
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=
DISCORD_DRY_RUN=

# --- Kit, for the daily subscriber email ---
KIT_API_KEY=
KIT_SENDER_EMAIL=
KIT_DAILY_FORM_UID=
KIT_DAILY_FORM_EMBED_SRC=
KIT_RECONCILIATION_START_DATE=
KIT_DRY_RUN=
KIT_DRAFT_MODE=

# --- site build ---
# Pinning this makes a rebuild byte-comparable against the committed site.
SITE_GENERATED_AT=
USERJOT_PROJECT_ID=
